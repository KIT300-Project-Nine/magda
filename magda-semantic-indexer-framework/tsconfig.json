{
    "extends": "../tsconfig-global.json",
    "compilerOptions": {
        "outDir": "./dist",
        "strictNullChecks": false,
        "rootDir": "./src",
        "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
        "baseUrl": ".",
        "paths": {
            "magda-typescript-common/src/*": [
                "../magda-typescript-common/dist/*"
            ],
            "magda-minion-framework/src/*": ["../magda-minion-framework/dist/*"]
        }
    },
    "include": ["./src"],
    "references": [
        {
            "path": "../magda-minion-framework"
        },
        {
            "path": "../magda-typescript-common"
        }
    ],
    "exclude": ["src/test/**/*", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
